{
  "name": "toril",
  "version": "0.0.2",
  "private": true,
  "description": "Self-hosted Toril preview",
  "license": "AGPL-3.0-only",
  "homepage": "https://toril.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorgiCorner/toril.git"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "image:build": "docker build --build-arg APP_VERSION=0.0.2 --build-arg APP_REVISION=local -t toril:local .",
    "image:smoke": "scripts/ci/smoke-image.sh",
    "test": "node --test",
    "ci": "npm run check:node && npm test"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.3 <11",
      "onFail": "error"
    }
  },
  "packageManager": "npm@10.9.3"
}
